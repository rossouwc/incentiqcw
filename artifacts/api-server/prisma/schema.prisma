generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_EXECUTIVE
  FINANCE
  EXECUTIVE
  PAYROLL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DealType {
  NET_NEW
  RENEWAL
  UPSELL
  CROSS_SELL
}

enum DealStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  MANAGER_APPROVED
  FINANCE_APPROVED
  EXECUTIVE_APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

enum PayoutStatus {
  PENDING
  FINANCE_APPROVED
  PAID
  REJECTED
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER
  PAYOUT
  ADJUSTMENT
}

enum NotificationType {
  DEAL_SUBMITTED
  DEAL_APPROVED
  DEAL_REJECTED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_PAID
  WALLET_CREDITED
  SYSTEM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id                 String           @id @default(cuid())
  companyName        String
  registrationNumber String?
  vatNumber          String?
  industry           String?
  contactName        String
  contactEmail       String
  contactPhone       String?
  status             TenantStatus     @default(ACTIVE)
  subscriptionPlan   SubscriptionPlan @default(STARTER)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  users                User[]
  commissionRules      CommissionRule[]
  commissionRuleGroups CommissionRuleGroup[]
  deals                Deal[]
  approvalWorkflows    ApprovalWorkflow[]
  wallets              Wallet[]
  walletTransactions   WalletTransaction[]
  payoutRequests       PayoutRequest[]
  taxProfiles          TaxProfile[]
  auditLogs            AuditLog[]
  notifications        Notification[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String
  passwordHash String
  role         UserRole   @default(SALES_EXECUTIVE)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealsAsExecutive     Deal[]             @relation("SalesExecutive")
  dealsSubmitted       Deal[]             @relation("SubmittedBy")
  approvalWorkflows    ApprovalWorkflow[]
  wallet               Wallet?
  payoutRequests       PayoutRequest[]
  taxProfile           TaxProfile?
  auditLogs            AuditLog[]
  notifications        Notification[]
  commissionGroups     CommissionRuleGroupMember[]

  @@unique([tenantId, email])
}

model CommissionRule {
  id                   String    @id @default(cuid())
  tenantId             String
  ruleName             String
  dealType             DealType
  commissionPercentage Float
  appliesToRole        UserRole  @default(SALES_EXECUTIVE)
  minGrossProfit       Float?
  maxGrossProfit       Float?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups CommissionRuleGroupRule[]
}

model CommissionRuleGroup {
  id          String   @id @default(cuid())
  tenantId    String
  groupName   String
  description String?
  assignToAll Boolean  @default(false)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules   CommissionRuleGroupRule[]
  members CommissionRuleGroupMember[]
}

model CommissionRuleGroupRule {
  groupId String
  ruleId  String

  group CommissionRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rule  CommissionRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([groupId, ruleId])
}

model CommissionRuleGroupMember {
  groupId String
  userId  String

  group CommissionRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Deal {
  id                    String     @id @default(cuid())
  tenantId              String
  salesExecutiveId      String
  customerName          String
  dealName              String
  dealType              DealType
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  revenue               Float      @default(0)
  cost                  Float      @default(0)
  grossProfit           Float      @default(0)
  grossProfitPercentage Float      @default(0)
  commissionPercentage  Float      @default(0)
  calculatedCommission  Float      @default(0)
  status                DealStatus @default(DRAFT)
  submittedById         String?
  submittedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesExecutive    User               @relation("SalesExecutive", fields: [salesExecutiveId], references: [id])
  submittedBy       User?              @relation("SubmittedBy", fields: [submittedById], references: [id])
  approvalWorkflows ApprovalWorkflow[]
}

model ApprovalWorkflow {
  id            String         @id @default(cuid())
  tenantId      String
  dealId        String
  approvalLevel Int
  approverRole  UserRole
  approverUserId String?
  status        ApprovalStatus @default(PENDING)
  comments      String?
  approvedAt    DateTime?
  createdAt     DateTime       @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  approver User?  @relation(fields: [approverUserId], references: [id])
}

model Wallet {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String   @unique
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  deferredBalance  Float    @default(0)
  paidOutBalance   Float    @default(0)
  updatedAt        DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id              String          @id @default(cuid())
  tenantId        String
  walletId        String
  transactionType TransactionType
  amount          Float
  referenceType   String?
  referenceId     String?
  description     String
  createdAt       DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id                  String       @id @default(cuid())
  tenantId            String
  userId              String
  requestedAmount     Float
  estimatedTax        Float        @default(0)
  estimatedNetPayout  Float        @default(0)
  payoutMonth         String
  status              PayoutStatus @default(PENDING)
  requestedAt         DateTime     @default(now())
  approvedAt          DateTime?
  paidAt              DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model TaxProfile {
  id                     String   @id @default(cuid())
  tenantId               String
  userId                 String   @unique
  monthlySalary          Float    @default(0)
  annualSalary           Float    @default(0)
  taxYear                Int
  medicalAidCredits      Float    @default(0)
  retirementContribution Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  title      String
  message    String
  type       NotificationType @default(SYSTEM)
  readStatus Boolean          @default(false)
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}
