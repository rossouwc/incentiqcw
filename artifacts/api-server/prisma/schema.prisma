generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_EXECUTIVE
  FINANCE
  EXECUTIVE
  PAYROLL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DealType {
  NET_NEW
  RENEWAL
  UPSELL
  CROSS_SELL
}

enum DealStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  MANAGER_APPROVED
  FINANCE_APPROVED
  EXECUTIVE_APPROVED
  PENDING_PAYROLL
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  WAITING
  APPROVED
  REJECTED
  ESCALATED
  CHANGES_REQUESTED
}

enum PayoutStatus {
  PENDING
  FINANCE_APPROVED
  PAYROLL_APPROVED
  PAID
  REJECTED
  DEFERRED
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER
  PAYOUT
  ADJUSTMENT
  PENDING_COMMISSION_ADDED
  PENDING_COMMISSION_REMOVED
  COMMISSION_APPROVED
  TRIGGER_RELEASED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_PAID
  PAYOUT_DEFERRED
  MANUAL_ADJUSTMENT
  COMMISSION_SPLIT_DEDUCTION
  COMMISSION_SPLIT_CREDIT
  CLAWBACK_DEDUCTION
  FUTURE_OFFSET_APPLIED
}

enum ClawbackType {
  FULL
  PARTIAL
  PRO_RATA
  FIXED_AMOUNT
  COMPONENT
  MANUAL_ADJUSTMENT
}

enum ClawbackReasonCategory {
  CANCELLATION
  TERMINATION
  NON_PAYMENT
  REVERSAL
  RETURN
  LAPSE
  NO_LONGER_QUALIFIES
  OTHER
}

enum ClawbackStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DECLINED
  WAIVED
  DISPUTED
  EXECUTED
}

enum RecoveryMethod {
  WALLET_DEDUCTION
  FUTURE_OFFSET
  MANUAL
  WAIVED
}

enum DealSourceType {
  SELF
  INTERNAL
  EXTERNAL
}

enum SplitDeductionType {
  PERCENTAGE
  FLAT_AMOUNT
}

enum TriggerStatus {
  NOT_TRIGGERED
  TRIGGERED
  WAIVED
  FAILED
}

enum NotificationType {
  DEAL_SUBMITTED
  DEAL_APPROVED
  DEAL_REJECTED
  DEAL_CHANGES_REQUESTED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_PAID
  WALLET_CREDITED
  AMENDMENT_REQUESTED
  AMENDMENT_ACCEPTED
  AMENDMENT_DECLINED
  CLAWBACK_CREATED
  CLAWBACK_APPROVED
  CLAWBACK_EXECUTED
  CLAWBACK_WAIVED
  CLAWBACK_DISPUTED
  SYSTEM
}

enum ChangeRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id                 String           @id @default(cuid())
  companyName        String
  registrationNumber String?
  vatNumber          String?
  industry           String?
  contactName        String
  contactEmail       String
  contactPhone       String?
  status             TenantStatus     @default(ACTIVE)
  subscriptionPlan   SubscriptionPlan @default(STARTER)
  payrollDay           Int?             @default(25)
  commissionCutoffDay  Int?             @default(20)
  onboardingStatus     String           @default("PENDING")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  users                User[]
  commissionRules      CommissionRule[]
  commissionRuleGroups CommissionRuleGroup[]
  deals                Deal[]
  approvalWorkflows    ApprovalWorkflow[]
  approvalConfigs      ApprovalConfig[]
  wallets              Wallet[]
  walletTransactions   WalletTransaction[]
  payoutRequests       PayoutRequest[]
  taxProfiles          TaxProfile[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  customers            Customer[]
  tenantIndustryConfig    TenantIndustryConfig?
  tenantApprovalWorkflows TenantApprovalWorkflow[]
  commissionEvents         CommissionEvent[]
  commissionEventApprovals CommissionEventApproval[]
  commissionEventTriggers  CommissionEventTrigger[]
  commissionDocuments      CommissionDocument[]
  externalProviders        ExternalProvider[]
  commissionSplitConfig    CommissionSplitConfig?
  changeRequests           ChangeRequest[]
  commissionClawbacks      CommissionClawback[]
  clawbackRecoveries       ClawbackRecovery[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String
  passwordHash String
  role         UserRole   @default(SALES_EXECUTIVE)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealsAsExecutive     Deal[]             @relation("SalesExecutive")
  dealsSubmitted       Deal[]             @relation("SubmittedBy")
  approvalWorkflows         ApprovalWorkflow[]
  approvalConfigsAssigned   ApprovalConfig[]  @relation("ApprovalConfigAssignee")
  wallet               Wallet?
  payoutRequests       PayoutRequest[]
  taxProfile           TaxProfile?
  auditLogs            AuditLog[]
  notifications        Notification[]
  commissionGroups     CommissionRuleGroupMember[]
  commissionEventsAsExecutive CommissionEvent[]          @relation("CommissionEventSalesExecutive")
  commissionEventApprovals    CommissionEventApproval[]
  triggeredTriggers           CommissionEventTrigger[]  @relation("TriggeredBy")
  uploadedDocuments           CommissionDocument[]      @relation("UploadedDocuments")
  internalReferralEvents      CommissionEvent[]          @relation("CommissionEventInternalReferrer")
  changeRequestsSubmitted     ChangeRequest[]           @relation("ChangeRequestedBy")
  changeRequestsReviewed      ChangeRequest[]           @relation("ChangeRequestReviewedBy")
  clawbacksAsExecutive        CommissionClawback[]      @relation("ClawbackSalesExec")
  clawbacksCreated            CommissionClawback[]      @relation("ClawbackCreatedBy")
  clawbacksApproved           CommissionClawback[]      @relation("ClawbackApprovedBy")
  clawbackRecoveriesCreated   ClawbackRecovery[]        @relation("RecoveryCreatedBy")

  @@unique([tenantId, email])
}

model CommissionRule {
  id                   String    @id @default(cuid())
  tenantId             String
  ruleName             String
  dealType             DealType
  commissionPercentage Float
  appliesToRole        UserRole  @default(SALES_EXECUTIVE)
  minGrossProfit       Float?
  maxGrossProfit       Float?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups CommissionRuleGroupRule[]
}

model CommissionRuleGroup {
  id          String   @id @default(cuid())
  tenantId    String
  groupName   String
  description String?
  assignToAll Boolean  @default(false)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules   CommissionRuleGroupRule[]
  members CommissionRuleGroupMember[]
}

model CommissionRuleGroupRule {
  groupId String
  ruleId  String

  group CommissionRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rule  CommissionRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([groupId, ruleId])
}

model CommissionRuleGroupMember {
  groupId String
  userId  String

  group CommissionRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Deal {
  id                    String     @id @default(cuid())
  tenantId              String
  salesExecutiveId      String
  customerName          String
  dealName              String
  dealType              DealType
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  revenue               Float      @default(0)
  cost                  Float      @default(0)
  grossProfit           Float      @default(0)
  grossProfitPercentage Float      @default(0)
  commissionPercentage  Float      @default(0)
  calculatedCommission  Float      @default(0)
  status                DealStatus @default(DRAFT)
  submittedById         String?
  submittedAt           DateTime?
  metadata              Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesExecutive    User               @relation("SalesExecutive", fields: [salesExecutiveId], references: [id])
  submittedBy       User?              @relation("SubmittedBy", fields: [submittedById], references: [id])
  approvalWorkflows ApprovalWorkflow[]
}

model ApprovalWorkflow {
  id             String         @id @default(cuid())
  tenantId       String
  dealId         String
  approvalLevel  Int
  stepName       String?
  approverRole   UserRole
  approverUserId String?
  status         ApprovalStatus @default(PENDING)
  comments       String?
  approvedAt     DateTime?
  payoutAmount   Decimal?       @db.Decimal(15, 2)
  createdAt      DateTime       @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  approver User?  @relation(fields: [approverUserId], references: [id])
}

model ApprovalConfig {
  id             String   @id @default(cuid())
  tenantId       String
  stepOrder      Int
  stepName       String
  approverRole   UserRole
  approverUserId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approver User?  @relation("ApprovalConfigAssignee", fields: [approverUserId], references: [id])

  @@unique([tenantId, stepOrder])
}

model Wallet {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String   @unique
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  deferredBalance  Float    @default(0)
  paidOutBalance   Float    @default(0)
  updatedAt        DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id              String          @id @default(cuid())
  tenantId        String
  walletId        String
  transactionType TransactionType
  amount          Float
  referenceType   String?
  referenceId     String?
  description     String
  createdAt       DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id                  String       @id @default(cuid())
  tenantId            String
  userId              String
  requestedAmount     Float
  estimatedTax        Float        @default(0)
  estimatedNetPayout  Float        @default(0)
  payoutMonth         String
  deferredToMonth     String?
  status              PayoutStatus @default(PENDING)
  comments            String?
  reviewerComments    String?
  requestedAt         DateTime     @default(now())
  approvedAt          DateTime?
  paidAt              DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model TaxProfile {
  id                     String   @id @default(cuid())
  tenantId               String
  userId                 String   @unique
  monthlySalary          Float    @default(0)
  annualSalary           Float    @default(0)
  taxYear                Int
  medicalAidCredits      Float    @default(0)
  retirementContribution Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaxBracket {
  id          String   @id @default(cuid())
  taxYear     Int
  fromIncome  Float
  toIncome    Float?
  rate        Float
  baseAmount  Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taxYear])
}

model TaxRebate {
  id        String   @id @default(cuid())
  taxYear   Int
  type      String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYear])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  title      String
  message    String
  type       NotificationType @default(SYSTEM)
  readStatus Boolean          @default(false)
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

// ─── Industry Template Models ─────────────────────────────────────────────────

model IndustryTemplate {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantConfigs            TenantIndustryConfig[]
  dealFieldDefinitions     DealFieldDefinition[]
  commissionFormulas       CommissionFormulaTemplate[]
  approvalWorkflowTemplates ApprovalWorkflowTemplate[]
  commissionEvents         CommissionEvent[]
}

model TenantIndustryConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  industryTemplateId  String
  customIndustryName  String?
  dealEntityName      String?
  commissionEventName String?
  triggerEventName    String?
  salesPersonName     String?
  isCustomised        Boolean  @default(false)
  terminologyJson     Json?
  fieldConfigJson     Json?
  formulaConfigJson   Json?
  triggerConfigJson   Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industryTemplate IndustryTemplate  @relation(fields: [industryTemplateId], references: [id])
}

model DealFieldDefinition {
  id                 String   @id @default(cuid())
  industryTemplateId String
  fieldKey           String
  fieldLabel         String
  fieldType          String
  isRequired         Boolean  @default(false)
  displayOrder       Int      @default(0)
  calculationRole    String?
  optionsJson        Json?
  validationJson     Json?
  isActive           Boolean  @default(true)

  industryTemplate IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)

  @@unique([industryTemplateId, fieldKey])
}

model CommissionFormulaTemplate {
  id                 String   @id @default(cuid())
  industryTemplateId String
  formulaName        String
  formulaCode        String
  formulaDescription String?
  calculationType    String
  formulaJson        Json?
  triggerEvent       String?
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)

  industryTemplate IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
}

model ApprovalWorkflowTemplate {
  id                 String   @id @default(cuid())
  industryTemplateId String
  workflowName       String
  approvalStepsJson  Json
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)

  industryTemplate IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
}

model TenantApprovalWorkflow {
  id                String   @id @default(cuid())
  tenantId          String
  workflowName      String
  industryCode      String?
  approvalStepsJson Json
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Commission Event Models ───────────────────────────────────────────────────

model CommissionEvent {
  id                        String          @id @default(cuid())
  tenantId                  String
  industryTemplateId        String?
  salesExecutiveId          String
  eventTitle                String
  eventType                 String
  eventDataJson             Json?
  revenueAmount             Float           @default(0)
  costAmount                Float           @default(0)
  grossProfitAmount         Float           @default(0)
  commissionBaseAmount      Float           @default(0)
  commissionPercentage      Float           @default(0)
  calculatedCommissionAmount Float          @default(0)
  sourceType                DealSourceType  @default(SELF)
  internalReferrerId        String?
  externalProviderId        String?
  splitReferrerName         String?
  splitDeductionAmount      Float?
  editStatus                String          @default("NONE")
  triggerStatus             String          @default("NOT_TRIGGERED")
  approvalStatus            String          @default("DRAFT")
  walletStatus              String          @default("PENDING")
  submittedAt               DateTime?
  approvedAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industryTemplate   IndustryTemplate?  @relation(fields: [industryTemplateId], references: [id])
  salesExecutive     User               @relation("CommissionEventSalesExecutive", fields: [salesExecutiveId], references: [id])
  internalReferrer   User?              @relation("CommissionEventInternalReferrer", fields: [internalReferrerId], references: [id])
  externalProvider   ExternalProvider?  @relation(fields: [externalProviderId], references: [id])
  approvals          CommissionEventApproval[]
  triggers           CommissionEventTrigger[]
  documents          CommissionDocument[]
  changeRequests     ChangeRequest[]
  clawbacks          CommissionClawback[]
}

model ChangeRequest {
  id                String              @id @default(cuid())
  tenantId          String
  commissionEventId String
  requestedById     String
  reviewedById      String?
  reason            String
  reviewNote        String?
  status            ChangeRequestStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvent CommissionEvent @relation(fields: [commissionEventId], references: [id], onDelete: Cascade)
  requestedBy     User            @relation("ChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy      User?           @relation("ChangeRequestReviewedBy", fields: [reviewedById], references: [id])
}

model CommissionEventApproval {
  id                String         @id @default(cuid())
  tenantId          String
  commissionEventId String
  approvalStep      Int
  stepName          String?
  approverRole      UserRole
  approverUserId    String?
  status            ApprovalStatus @default(PENDING)
  comments          String?
  payoutAmount      Decimal?       @db.Decimal(15, 2)
  approvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvent CommissionEvent @relation(fields: [commissionEventId], references: [id], onDelete: Cascade)
  approver        User?           @relation(fields: [approverUserId], references: [id])
}

// ─── Commission Event Trigger Models ─────────────────────────────────────────

model CommissionEventTrigger {
  id                String        @id @default(cuid())
  tenantId          String
  commissionEventId String
  triggerEventType  String
  label             String
  description       String?
  status            TriggerStatus @default(NOT_TRIGGERED)
  notes             String?
  triggeredById     String?
  triggeredAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvent CommissionEvent @relation(fields: [commissionEventId], references: [id], onDelete: Cascade)
  triggeredBy     User?           @relation("TriggeredBy", fields: [triggeredById], references: [id])
}

// ─── Commission Event Supporting Documents ────────────────────────────────────

model CommissionDocument {
  id                String   @id @default(cuid())
  tenantId          String
  commissionEventId String
  documentType      String   @default("LINK")
  fileName          String
  fileUrl           String
  description       String?
  uploadedById      String
  createdAt         DateTime @default(now())

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvent CommissionEvent @relation(fields: [commissionEventId], references: [id], onDelete: Cascade)
  uploadedBy      User            @relation("UploadedDocuments", fields: [uploadedById], references: [id])
}

// ─── Deal Source Models ────────────────────────────────────────────────────────

model ExternalProvider {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  contactName  String?
  contactEmail String?
  providerType String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvents CommissionEvent[]

  @@unique([tenantId, name])
}

model CommissionSplitConfig {
  id              String             @id @default(cuid())
  tenantId        String             @unique
  isEnabled       Boolean            @default(false)
  internalLabel   String             @default("Internal Referral")
  deductionType   SplitDeductionType @default(PERCENTAGE)
  deductionValue  Float              @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Commission Clawback / Reversal / Recovery ────────────────────────────────

model CommissionClawback {
  id                       String                 @id @default(cuid())
  tenantId                 String
  commissionEventId        String
  salesExecutiveId         String
  clawbackType             ClawbackType
  reasonCategory           ClawbackReasonCategory
  reason                   String
  originalCommissionAmount Decimal                @db.Decimal(15, 2)
  clawbackAmount           Decimal                @db.Decimal(15, 2)
  recoveredAmount          Decimal                @default(0) @db.Decimal(15, 2)
  outstandingAmount        Decimal                @default(0) @db.Decimal(15, 2)
  proRataFactor            Decimal?               @db.Decimal(6, 4)
  componentDescription     String?
  status                   ClawbackStatus         @default(DRAFT)
  notes                    String?
  waiveReason              String?
  disputeNote              String?
  disputedAt               DateTime?
  approvedAt               DateTime?
  executedAt               DateTime?
  createdById              String
  approvedById             String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvent CommissionEvent     @relation(fields: [commissionEventId], references: [id])
  salesExecutive  User                @relation("ClawbackSalesExec", fields: [salesExecutiveId], references: [id])
  createdBy       User                @relation("ClawbackCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?               @relation("ClawbackApprovedBy", fields: [approvedById], references: [id])
  recoveries      ClawbackRecovery[]
}

model ClawbackRecovery {
  id             String         @id @default(cuid())
  tenantId       String
  clawbackId     String
  recoveryMethod RecoveryMethod
  amount         Decimal        @db.Decimal(15, 2)
  description    String?
  referenceId    String?
  createdById    String
  createdAt      DateTime       @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clawback  CommissionClawback @relation(fields: [clawbackId], references: [id], onDelete: Cascade)
  createdBy User               @relation("RecoveryCreatedBy", fields: [createdById], references: [id])
}
