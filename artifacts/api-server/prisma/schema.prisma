generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  INACTIVE
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_EXECUTIVE
  FINANCE
  EXECUTIVE
  PAYROLL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum DealType {
  NET_NEW
  RENEWAL
  UPSELL
  CROSS_SELL
}

enum DealStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  MANAGER_APPROVED
  FINANCE_APPROVED
  EXECUTIVE_APPROVED
  PENDING_PAYROLL
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  WAITING
  APPROVED
  REJECTED
  ESCALATED
  CHANGES_REQUESTED
}

enum PayoutStatus {
  PENDING
  FINANCE_APPROVED
  PAYROLL_APPROVED
  PAID
  REJECTED
  DEFERRED
}

enum TransactionType {
  CREDIT
  DEBIT
  TRANSFER
  PAYOUT
  ADJUSTMENT
  PENDING_COMMISSION_ADDED
  PENDING_COMMISSION_REMOVED
  COMMISSION_APPROVED
  TRIGGER_RELEASED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_PAID
  PAYOUT_DEFERRED
  MANUAL_ADJUSTMENT
}

enum TriggerStatus {
  NOT_TRIGGERED
  TRIGGERED
  WAIVED
  FAILED
}

enum NotificationType {
  DEAL_SUBMITTED
  DEAL_APPROVED
  DEAL_REJECTED
  DEAL_CHANGES_REQUESTED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_PAID
  WALLET_CREDITED
  SYSTEM
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id                 String           @id @default(cuid())
  companyName        String
  registrationNumber String?
  vatNumber          String?
  industry           String?
  contactName        String
  contactEmail       String
  contactPhone       String?
  status             TenantStatus     @default(ACTIVE)
  subscriptionPlan   SubscriptionPlan @default(STARTER)
  payrollDay           Int?             @default(25)
  commissionCutoffDay  Int?             @default(20)
  onboardingStatus     String           @default("PENDING")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  users                User[]
  commissionRules      CommissionRule[]
  commissionRuleGroups CommissionRuleGroup[]
  deals                Deal[]
  approvalWorkflows    ApprovalWorkflow[]
  approvalConfigs      ApprovalConfig[]
  wallets              Wallet[]
  walletTransactions   WalletTransaction[]
  payoutRequests       PayoutRequest[]
  taxProfiles          TaxProfile[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  customers            Customer[]
  tenantIndustryConfig    TenantIndustryConfig?
  tenantApprovalWorkflows TenantApprovalWorkflow[]
  commissionEvents         CommissionEvent[]
  commissionEventApprovals CommissionEventApproval[]
  commissionEventTriggers  CommissionEventTrigger[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  firstName    String
  lastName     String
  email        String
  passwordHash String
  role         UserRole   @default(SALES_EXECUTIVE)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealsAsExecutive     Deal[]             @relation("SalesExecutive")
  dealsSubmitted       Deal[]             @relation("SubmittedBy")
  approvalWorkflows         ApprovalWorkflow[]
  approvalConfigsAssigned   ApprovalConfig[]  @relation("ApprovalConfigAssignee")
  wallet               Wallet?
  payoutRequests       PayoutRequest[]
  taxProfile           TaxProfile?
  auditLogs            AuditLog[]
  notifications        Notification[]
  commissionGroups     CommissionRuleGroupMember[]
  commissionEventsAsExecutive CommissionEvent[]          @relation("CommissionEventSalesExecutive")
  commissionEventApprovals    CommissionEventApproval[]
  triggeredTriggers           CommissionEventTrigger[]  @relation("TriggeredBy")

  @@unique([tenantId, email])
}

model CommissionRule {
  id                   String    @id @default(cuid())
  tenantId             String
  ruleName             String
  dealType             DealType
  commissionPercentage Float
  appliesToRole        UserRole  @default(SALES_EXECUTIVE)
  minGrossProfit       Float?
  maxGrossProfit       Float?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups CommissionRuleGroupRule[]
}

model CommissionRuleGroup {
  id          String   @id @default(cuid())
  tenantId    String
  groupName   String
  description String?
  assignToAll Boolean  @default(false)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rules   CommissionRuleGroupRule[]
  members CommissionRuleGroupMember[]
}

model CommissionRuleGroupRule {
  groupId String
  ruleId  String

  group CommissionRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rule  CommissionRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([groupId, ruleId])
}

model CommissionRuleGroupMember {
  groupId String
  userId  String

  group CommissionRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Deal {
  id                    String     @id @default(cuid())
  tenantId              String
  salesExecutiveId      String
  customerName          String
  dealName              String
  dealType              DealType
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  revenue               Float      @default(0)
  cost                  Float      @default(0)
  grossProfit           Float      @default(0)
  grossProfitPercentage Float      @default(0)
  commissionPercentage  Float      @default(0)
  calculatedCommission  Float      @default(0)
  status                DealStatus @default(DRAFT)
  submittedById         String?
  submittedAt           DateTime?
  metadata              Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesExecutive    User               @relation("SalesExecutive", fields: [salesExecutiveId], references: [id])
  submittedBy       User?              @relation("SubmittedBy", fields: [submittedById], references: [id])
  approvalWorkflows ApprovalWorkflow[]
}

model ApprovalWorkflow {
  id             String         @id @default(cuid())
  tenantId       String
  dealId         String
  approvalLevel  Int
  stepName       String?
  approverRole   UserRole
  approverUserId String?
  status         ApprovalStatus @default(PENDING)
  comments       String?
  approvedAt     DateTime?
  payoutAmount   Decimal?       @db.Decimal(15, 2)
  createdAt      DateTime       @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  approver User?  @relation(fields: [approverUserId], references: [id])
}

model ApprovalConfig {
  id             String   @id @default(cuid())
  tenantId       String
  stepOrder      Int
  stepName       String
  approverRole   UserRole
  approverUserId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approver User?  @relation("ApprovalConfigAssignee", fields: [approverUserId], references: [id])

  @@unique([tenantId, stepOrder])
}

model Wallet {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String   @unique
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  deferredBalance  Float    @default(0)
  paidOutBalance   Float    @default(0)
  updatedAt        DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id              String          @id @default(cuid())
  tenantId        String
  walletId        String
  transactionType TransactionType
  amount          Float
  referenceType   String?
  referenceId     String?
  description     String
  createdAt       DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id                  String       @id @default(cuid())
  tenantId            String
  userId              String
  requestedAmount     Float
  estimatedTax        Float        @default(0)
  estimatedNetPayout  Float        @default(0)
  payoutMonth         String
  deferredToMonth     String?
  status              PayoutStatus @default(PENDING)
  comments            String?
  reviewerComments    String?
  requestedAt         DateTime     @default(now())
  approvedAt          DateTime?
  paidAt              DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model TaxProfile {
  id                     String   @id @default(cuid())
  tenantId               String
  userId                 String   @unique
  monthlySalary          Float    @default(0)
  annualSalary           Float    @default(0)
  taxYear                Int
  medicalAidCredits      Float    @default(0)
  retirementContribution Float    @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaxBracket {
  id          String   @id @default(cuid())
  taxYear     Int
  fromIncome  Float
  toIncome    Float?
  rate        Float
  baseAmount  Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taxYear])
}

model TaxRebate {
  id        String   @id @default(cuid())
  taxYear   Int
  type      String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taxYear])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  title      String
  message    String
  type       NotificationType @default(SYSTEM)
  readStatus Boolean          @default(false)
  createdAt  DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

// ─── Industry Template Models ─────────────────────────────────────────────────

model IndustryTemplate {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantConfigs            TenantIndustryConfig[]
  dealFieldDefinitions     DealFieldDefinition[]
  commissionFormulas       CommissionFormulaTemplate[]
  approvalWorkflowTemplates ApprovalWorkflowTemplate[]
  commissionEvents         CommissionEvent[]
}

model TenantIndustryConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  industryTemplateId  String
  customIndustryName  String?
  dealEntityName      String?
  commissionEventName String?
  triggerEventName    String?
  salesPersonName     String?
  isCustomised        Boolean  @default(false)
  terminologyJson     Json?
  fieldConfigJson     Json?
  formulaConfigJson   Json?
  triggerConfigJson   Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industryTemplate IndustryTemplate  @relation(fields: [industryTemplateId], references: [id])
}

model DealFieldDefinition {
  id                 String   @id @default(cuid())
  industryTemplateId String
  fieldKey           String
  fieldLabel         String
  fieldType          String
  isRequired         Boolean  @default(false)
  displayOrder       Int      @default(0)
  calculationRole    String?
  optionsJson        Json?
  validationJson     Json?
  isActive           Boolean  @default(true)

  industryTemplate IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)

  @@unique([industryTemplateId, fieldKey])
}

model CommissionFormulaTemplate {
  id                 String   @id @default(cuid())
  industryTemplateId String
  formulaName        String
  formulaCode        String
  formulaDescription String?
  calculationType    String
  formulaJson        Json?
  triggerEvent       String?
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)

  industryTemplate IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
}

model ApprovalWorkflowTemplate {
  id                 String   @id @default(cuid())
  industryTemplateId String
  workflowName       String
  approvalStepsJson  Json
  isDefault          Boolean  @default(false)
  isActive           Boolean  @default(true)

  industryTemplate IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
}

model TenantApprovalWorkflow {
  id                String   @id @default(cuid())
  tenantId          String
  workflowName      String
  industryCode      String?
  approvalStepsJson Json
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Commission Event Models ───────────────────────────────────────────────────

model CommissionEvent {
  id                        String    @id @default(cuid())
  tenantId                  String
  industryTemplateId        String?
  salesExecutiveId          String
  eventTitle                String
  eventType                 String
  eventDataJson             Json?
  revenueAmount             Float     @default(0)
  costAmount                Float     @default(0)
  grossProfitAmount         Float     @default(0)
  commissionBaseAmount      Float     @default(0)
  commissionPercentage      Float     @default(0)
  calculatedCommissionAmount Float    @default(0)
  triggerStatus             String    @default("NOT_TRIGGERED")
  approvalStatus            String    @default("DRAFT")
  walletStatus              String    @default("PENDING")
  submittedAt               DateTime?
  approvedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industryTemplate IndustryTemplate?  @relation(fields: [industryTemplateId], references: [id])
  salesExecutive   User               @relation("CommissionEventSalesExecutive", fields: [salesExecutiveId], references: [id])
  approvals        CommissionEventApproval[]
  triggers         CommissionEventTrigger[]
}

model CommissionEventApproval {
  id                String         @id @default(cuid())
  tenantId          String
  commissionEventId String
  approvalStep      Int
  stepName          String?
  approverRole      UserRole
  approverUserId    String?
  status            ApprovalStatus @default(PENDING)
  comments          String?
  payoutAmount      Decimal?       @db.Decimal(15, 2)
  approvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvent CommissionEvent @relation(fields: [commissionEventId], references: [id], onDelete: Cascade)
  approver        User?           @relation(fields: [approverUserId], references: [id])
}

// ─── Commission Event Trigger Models ─────────────────────────────────────────

model CommissionEventTrigger {
  id                String        @id @default(cuid())
  tenantId          String
  commissionEventId String
  triggerEventType  String
  label             String
  description       String?
  status            TriggerStatus @default(NOT_TRIGGERED)
  notes             String?
  triggeredById     String?
  triggeredAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissionEvent CommissionEvent @relation(fields: [commissionEventId], references: [id], onDelete: Cascade)
  triggeredBy     User?           @relation("TriggeredBy", fields: [triggeredById], references: [id])
}
